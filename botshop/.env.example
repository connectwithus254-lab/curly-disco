# ---------------------------------------------------------------------------
# BotShop configuration. Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public HTTPS base URL. Telegram refuses to deliver webhooks to anything else.
PUBLIC_BASE_URL=http://localhost:3000

# The application connects with the RLS-enforcing role…
DATABASE_URL=postgres://botshop_app:botshop_app@127.0.0.1:54329/botshop
# …while migrations/seed/pg-boss use the owner role (DDL + job schema).
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54329/botshop

# Envelope encryption for tenant secrets (bot tokens, later gateway keys).
# Generate with: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('hex'))"
# Rotate by appending a new key id and setting ENCRYPTION_ACTIVE_KEY_ID to it.
ENCRYPTION_KEYS=k1:replace_me_with_64_hex_characters
ENCRYPTION_ACTIVE_KEY_ID=k1

# fake = fully offline (nothing is sent to Telegram); live = real Bot API.
TELEGRAM_MODE=fake
# Optional: point at a self-hosted Bot API server or the local fake server.
# TELEGRAM_API_ROOT=http://localhost:8081
# Polling lets a real bot run without a public URL (handy on a laptop or private VPS).
TELEGRAM_POLLING=false
TELEGRAM_WEBHOOK_ENABLED=true

SESSION_TTL_HOURS=336
TELEGRAM_SENDS_PER_MINUTE=20
LOG_LEVEL=info

# Seed credentials for local/demo environments only.
SEED_OWNER_EMAIL=owner@kesi.test
SEED_OWNER_PASSWORD=demo-password-123
SEED_ADMIN_EMAIL=admin@botshop.test
SEED_ADMIN_PASSWORD=demo-password-123
