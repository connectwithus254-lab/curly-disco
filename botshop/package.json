{
  "name": "botshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant Telegram commerce platform for non-technical sellers",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:up": "node scripts/db.mjs up",
    "db:reset": "node scripts/db.mjs reset",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:seed": "tsx packages/db/src/cli.ts seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "start": "tsx apps/api/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
