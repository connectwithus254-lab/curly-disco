//@version=6
strategy("Adaptive Quantitative Market Regime Strategy", "AQMRS", overlay = true, initial_capital = 100000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10.0, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, pyramiding = 0, calc_on_every_tick = false, max_bars_back = 1000, max_labels_count = 500, max_lines_count = 500)

// ============================================================================
// ARCHITECTURAL & METHODOLOGICAL SPECIFICATION
// ============================================================================
// The Adaptive Quantitative Market Regime Strategy (AQMRS) is an institutional-grade,
// multi-factor quantitative trading system designed for multi-asset deployment
// (Gold & Commodity Futures, Crypto, Indices, Forex, and Equities).
//
// Core Quantitative Pillars:
// 1. Strict Anti-Repainting: Zero lookahead bias. All Higher-Timeframe (HTF)
//    security queries strictly fetch confirmed closed bars ([1] offset with
//    barmerge.lookahead_off). Swing pivots are confirmed strictly after right-bars lag.
// 2. Swing Extremum / Turning-Point Engine: Captures cycle bottoms (troughs)
//    and cycle tops (crests) by detecting volatility band exhaustion (Z <= -1.6 sigma),
//    second-derivative Price Curvature inflection, institutional absorption wicks,
//    and RSI momentum rebound, buying/selling at the earliest confirmed reversal point.
// 3. News Catalyst & Macro Event Engine: Automatically detects high-impact news
//    shocks via volume expansion anomalies (RVOL >= 2.2x) and range expansion (True Range
//    >= 1.8x ATR). Offers 3 operating modes: fading news overreactions at extremes,
//    riding institutional news momentum, or news volatility filtering.
// 4. Multi-Factor Scoring Engine: Long and Short scores (0-100) are computed
//    independently across 13 mathematical factors (Trend, HTF, Momentum, ADX,
//    RSI Regime, VWAP, Volume, Volatility, Z-Score, Price Curvature, Greeks Proxies,
//    Market Structure BOS, and Kaufman ER).
// 5. Regime Adaptation: Dynamically transitions risk/reward ratios, stop widths,
//    and scoring thresholds across 6 quantified market regimes (Strong Trend,
//    Weak Trend, High Volatility, Low Volatility/Squeeze, Range, Transition).
// 6. Dynamic Trade Management: ATR ratchet trailing stop, break-even protection,
//    and trend reversal exits designed to let winners run while cutting losers quickly.
// ============================================================================

// ============================================================================
// 1. STRATEGY RISK & POSITION SIZING
// ============================================================================
grp_risk = "1. Strategy Risk & Position Sizing"
sizingMode = input.string("% of Equity Capital", "Position Sizing Mode", options = ["% of Equity Capital", "Risk % of Equity", "Fixed Units"], group = grp_risk, tooltip = "% of Equity Capital is universally compatible across Futures, Crypto, and Stocks.")
capitalAllocationPct = input.float(10.0, "Capital Allocation % (for % Equity Mode)", minval = 1.0, maxval = 100.0, step = 1.0, group = grp_risk)
riskPerTradePct = input.float(1.0, "Risk % of Equity per Trade (for Risk Mode)", minval = 0.05, maxval = 10.0, step = 0.1, group = grp_risk)
fixedUnitsQty = input.float(1.0, "Fixed Order Units", minval = 0.0001, step = 0.1, group = grp_risk)
enableConfidenceSizing = input.bool(false, "Enable Score-Weighted Size Scaling", group = grp_risk, tooltip = "Scale position size slightly with higher composite score (max +30%). Default off for strict risk discipline.")

// ============================================================================
// 2. STOP LOSS, TAKE PROFIT & TRAILING RULES
// ============================================================================
grp_stops = "2. Stop Loss, Take Profit & Trailing Rules"
baseAtrStopMult = input.float(2.0, "Base ATR Stop Loss Multiplier", minval = 0.5, maxval = 10.0, step = 0.1, group = grp_stops)
baseTargetRr = input.float(2.0, "Base Risk/Reward Ratio", minval = 0.5, maxval = 10.0, step = 0.1, group = grp_stops)
adaptiveRrEnabled = input.bool(true, "Adaptive Regime Risk/Reward", group = grp_stops, tooltip = "Expands R:R in strong trends and tightens in ranges.")
enableBreakEven = input.bool(true, "Enable Break-Even Stop", group = grp_stops)
beTriggerAtr = input.float(2.0, "Break-Even Trigger (ATR Multiples)", minval = 0.5, step = 0.1, group = grp_stops, tooltip = "Set to at least 2.0 ATR to avoid premature stopouts on normal noise.")
beOffsetAtr = input.float(0.15, "Break-Even Profit Buffer (ATR Multiples)", minval = 0.0, step = 0.05, group = grp_stops)
enableTrailingStop = input.bool(true, "Enable Dynamic ATR Trailing Stop", group = grp_stops)
trailActivationAtr = input.float(2.2, "Trailing Activation Profit (ATR Multiples)", minval = 0.5, step = 0.1, group = grp_stops, tooltip = "Profit threshold required before trailing stop begins ratcheting.")
trailAtrMult = input.float(2.2, "Trailing Stop Distance (ATR Multiples)", minval = 0.5, step = 0.1, group = grp_stops)
trailLookback = input.int(5, "Trailing Stop Pivot Lookback Bars", minval = 2, maxval = 30, group = grp_stops)
maxHoldingBars = input.int(120, "Maximum Holding Period (Bars, 0 = Disabled)", minval = 0, maxval = 1000, group = grp_stops)
exitOnMomentumCollapse = input.bool(true, "Exit on Trend Reversal (EMA Cross)", group = grp_stops)
exitOnOppositeScore = input.bool(true, "Exit on Extreme Opposite Score", group = grp_stops)
oppExitScoreThreshold = input.float(80.0, "Opposite Exit Score Threshold", minval = 50.0, maxval = 100.0, group = grp_stops)

// ============================================================================
// 3. EXECUTION MODE & SWING EXTREMUM (BOTTOM/TOP) ENGINE
// ============================================================================
grp_mode = "3. Execution Style & Swing Extremum Engine"
executionStyle = input.string("Hybrid (Bottom/Top Extremum + Trends)", "Execution Style", options = ["Hybrid (Bottom/Top Extremum + Trends)", "Extremum Reversals (Lowest/Highest Points)", "Trend Pullbacks & Breakouts"], group = grp_mode)
enableExtremumEngine = input.bool(true, "Enable Extremum Turning-Point Engine", group = grp_mode, tooltip = "Detects cycle bottoms (troughs) and tops (crests) using volatility bands, 2nd derivative curvature inflection, and absorption wicks.")
extremumZThreshold = input.float(1.5, "Extremum Z-Score Reversion Threshold (Std Dev)", minval = 1.0, maxval = 3.0, step = 0.1, group = grp_mode)
minRejectionWickPct = input.float(25.0, "Minimum Absorption Rejection Wick %", minval = 10.0, maxval = 60.0, step = 5.0, group = grp_mode, tooltip = "Percentage of candle range that must be wick absorption at swing bottom or top.")

// Anti-Exhaustion Gating
enableAntiExhaustion = input.bool(true, "Enable Anti-Exhaustion Filter for Trends", group = grp_mode, tooltip = "Prevents buying at the peak of extended spikes in trend mode. Requires pullbacks to value.")
maxDistFastAtr = input.float(1.3, "Max Allowed Distance from Fast EMA (ATR)", minval = 0.5, maxval = 3.0, step = 0.1, group = grp_mode)
maxDistMedAtr = input.float(2.2, "Max Allowed Distance from Med EMA (ATR)", minval = 1.0, maxval = 5.0, step = 0.1, group = grp_mode)
maxLongRsi = input.float(70.0, "Max RSI for Long Entries", minval = 50.0, maxval = 90.0, group = grp_mode)
minShortRsi = input.float(30.0, "Min RSI for Short Entries", minval = 10.0, maxval = 50.0, group = grp_mode)

// ============================================================================
// 4. NEWS CATALYST & MACRO EVENT ENGINE
// ============================================================================
grp_news = "4. News Catalyst & Macro Event Engine"
enableNewsEngine = input.bool(true, "Enable News Catalyst Detection", group = grp_news, tooltip = "Detects news releases via volume anomalies and ATR range expansion spikes.")
newsMode = input.string("Fade News Overreaction (Bottom/Top)", "News Event Strategy Mode", options = ["Fade News Overreaction (Bottom/Top)", "Ride News Breakout Momentum", "Halt Trading (News Blackout)"], group = grp_news)
newsVolThreshold = input.float(2.2, "News Volume Spike Anomaly (x 20-SMA)", minval = 1.5, maxval = 10.0, step = 0.1, group = grp_news)
newsAtrExpansion = input.float(1.8, "News Candle Range Expansion (x ATR)", minval = 1.2, maxval = 5.0, step = 0.1, group = grp_news)
externalNewsSentiment = input.float(0.0, "External News Sentiment (-100 to +100)", minval = -100.0, maxval = 100.0, step = 5.0, group = grp_news, tooltip = "Can be set manually or fed dynamically via TradingView webhook alerts / external news bots.")
enableMacroIntermarket = input.bool(false, "Enable DXY Dollar Macro Filter", group = grp_news, tooltip = "When enabled, queries US Dollar Index (DXY). Weak dollar boosts gold/equity long scores.")

// ============================================================================
// 5. SCORING MODEL THRESHOLDS & MULTI-FACTOR WEIGHTS
// ============================================================================
grp_score = "5. Scoring Thresholds & Multi-Factor Weights"
longThreshold = input.float(65.0, "Long Entry Score Threshold (0-100)", minval = 40.0, maxval = 95.0, step = 1.0, group = grp_score)
shortThreshold = input.float(65.0, "Short Entry Score Threshold (0-100)", minval = 40.0, maxval = 95.0, step = 1.0, group = grp_score)
requireHtfNonOpposite = input.bool(true, "HTF Direction Filter", group = grp_score)
allowBosHtfOverride = input.bool(true, "Allow Local BOS to Override HTF Contradiction", group = grp_score)
minAdxTrendFilter = input.float(16.0, "Minimum ADX for Trend Entries", minval = 0.0, maxval = 50.0, group = grp_score)
minAtrPctFilter = input.float(0.02, "Minimum ATR % of Price (Liquidity Filter)", minval = 0.0, maxval = 5.0, step = 0.01, group = grp_score)
regimeAdaptiveThresholds = input.bool(true, "Regime-Adaptive Entry Thresholds", group = grp_score)

w_trend = input.float(16.0, "Weight: Trend Engine", minval = 0.0, maxval = 50.0, group = grp_score)
w_htf = input.float(14.0, "Weight: HTF Trend", minval = 0.0, maxval = 50.0, group = grp_score)
w_mom = input.float(14.0, "Weight: Momentum Engine", minval = 0.0, maxval = 50.0, group = grp_score)
w_adx = input.float(10.0, "Weight: ADX / Directional", minval = 0.0, maxval = 50.0, group = grp_score)
w_rsiRegime = input.float(6.0, "Weight: RSI Regime Context", minval = 0.0, maxval = 50.0, group = grp_score)
w_vwap = input.float(6.0, "Weight: VWAP Relationship", minval = 0.0, maxval = 50.0, group = grp_score)
w_volume = input.float(6.0, "Weight: Volume & CMF", minval = 0.0, maxval = 50.0, group = grp_score)
w_volatility = input.float(6.0, "Weight: Volatility Regime", minval = 0.0, maxval = 50.0, group = grp_score)
w_zScore = input.float(6.0, "Weight: Price Z-Score", minval = 0.0, maxval = 50.0, group = grp_score)
w_curvature = input.float(6.0, "Weight: Price Curvature (2nd Deriv)", minval = 0.0, maxval = 50.0, group = grp_score)
w_structure = input.float(10.0, "Weight: Market Structure (BOS)", minval = 0.0, maxval = 50.0, group = grp_score)
w_er = input.float(6.0, "Weight: Kaufman Price Efficiency", minval = 0.0, maxval = 50.0, group = grp_score)

// ============================================================================
// 6. TECHNICAL INDICATORS & ANTI-REPAINT HTF
// ============================================================================
grp_ind = "6. Indicators & Higher Timeframe Parameters"
fastEmaLen = input.int(9, "Fast EMA Length", minval = 2, maxval = 100, group = grp_ind)
medEmaLen = input.int(50, "Medium EMA Length", minval = 5, maxval = 200, group = grp_ind)
slowEmaLen = input.int(200, "Slow EMA Length", minval = 20, maxval = 500, group = grp_ind)
useHma = input.bool(true, "Include Hull Moving Average (HMA)", group = grp_ind)
hmaLen = input.int(21, "HMA Length", minval = 3, maxval = 200, group = grp_ind)

htfTimeframe = input.timeframe("60", "HTF Timeframe", group = grp_ind)
htfFastEmaLen = input.int(20, "HTF Fast EMA Length", minval = 2, maxval = 200, group = grp_ind)
htfSlowEmaLen = input.int(50, "HTF Slow EMA Length", minval = 5, maxval = 500, group = grp_ind)
htfStrictAntiRepaint = input.bool(true, "HTF Confirmed Bar Only [1] (Anti-Repaint)", group = grp_ind)

rsiLen = input.int(14, "RSI Length", minval = 2, maxval = 100, group = grp_ind)
adxLen = input.int(14, "ADX Period", minval = 2, maxval = 100, group = grp_ind)
adxSmoothing = input.int(14, "ADX Smoothing", minval = 1, maxval = 50, group = grp_ind)
adxTrendLevel = input.float(25.0, "ADX Strong Trend Threshold", minval = 10.0, maxval = 50.0, group = grp_ind)

atrLen = input.int(14, "ATR Length", minval = 1, maxval = 100, group = grp_ind)
volPercentileLookback = input.int(100, "Volatility Percentile Lookback", minval = 20, maxval = 500, group = grp_ind)
bbLen = input.int(20, "Bollinger Bands Length", minval = 5, maxval = 100, group = grp_ind)
bbMult = input.float(2.0, "Bollinger Bands Multiplier", minval = 0.5, maxval = 4.0, step = 0.1, group = grp_ind)
zScoreLen = input.int(20, "Rolling Z-Score Length", minval = 5, maxval = 200, group = grp_ind)
erLen = input.int(10, "Kaufman ER Length", minval = 2, maxval = 100, group = grp_ind)
curvatureSmoothLen = input.int(3, "Price Curvature Smoothing EMA", minval = 1, maxval = 20, group = grp_ind)
pivotLeftBars = input.int(5, "Pivot Left Bars", minval = 1, maxval = 30, group = grp_ind)
pivotRightBars = input.int(5, "Pivot Right Bars (Strict Non-Repainting Lag)", minval = 1, maxval = 30, group = grp_ind)

cooldownBars = input.int(5, "Entry Cooldown (Minimum Bars Between Trades)", minval = 0, maxval = 50, group = grp_ind)
maxTradesPerDay = input.int(5, "Maximum Trades Per Day", minval = 1, maxval = 50, group = grp_ind)

// ============================================================================
// 7. VISUAL AESTHETICS & DASHBOARD SETTINGS
// ============================================================================
grp_visual = "7. Visual Aesthetics & Dashboard"
showDashboard = input.bool(true, "Show Quantitative Dashboard Table", group = grp_visual)
dashboardPos = input.string("Bottom Right", "Dashboard Position", options = ["Bottom Right", "Top Right", "Bottom Left", "Top Left"], group = grp_visual)
dashboardTextSize = input.string("Small", "Dashboard Text Size", options = ["Small", "Tiny"], group = grp_visual)
showEmaLines = input.bool(true, "Show EMA Trend Lines", group = grp_visual)
showEmaCloud = input.bool(true, "Show Trend Cloud (Fast-Med EMA)", group = grp_visual)
showVwapLine = input.bool(true, "Show VWAP Line", group = grp_visual)
showSignals = input.bool(true, "Show Entry Signal Triangles", group = grp_visual)
showPriceLabels = input.bool(true, "Show Entry Price Labels (BUY / SELL @ Price)", group = grp_visual)
showExitMarkers = input.bool(true, "Show TP / SL / Trail Exit Badges", group = grp_visual)
showStopTargetLines = input.bool(true, "Show Active Stop & Target Lines", group = grp_visual)

// ============================================================================
// MATHEMATICAL ENGINE CALCULATIONS
// ============================================================================

// --- 1. CORE VOLATILITY & PERCENTILES ---
atrVal = ta.atr(atrLen)
safeAtr = (na(atrVal) or atrVal <= 0.0) ? (close * 0.01) : atrVal
atrPct = (safeAtr / close) * 100.0

atrPercentile = nz(ta.percentrank(safeAtr, volPercentileLookback), 50.0)

bbBasis = ta.sma(close, bbLen)
bbDev = bbMult * ta.stdev(close, bbLen)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = bbBasis != 0.0 ? ((bbUpper - bbLower) / bbBasis) * 100.0 : 0.0
bbwPercentile = nz(ta.percentrank(bbWidth, volPercentileLookback), 50.0)

isVolSqueeze = bbwPercentile <= 20.0 and atrPercentile <= 25.0
isVolExpansion = bbwPercentile >= 80.0 or atrPercentile >= 80.0

// --- 2. TREND ENGINE ---
emaFast = ta.ema(close, fastEmaLen)
emaMed = ta.ema(close, medEmaLen)
emaSlow = ta.ema(close, slowEmaLen)
hmaVal = useHma ? ta.hma(close, hmaLen) : emaFast

bullishTrendAlign = close > emaFast and emaFast > emaMed and emaMed > emaSlow
bearishTrendAlign = close < emaFast and emaFast < emaMed and emaMed < emaSlow
fastSlopeUp = emaFast > emaFast[1]
medSlopeUp = emaMed > emaMed[1]
hmaSlopeUp = hmaVal > hmaVal[1]

trendDistAtr = (emaFast - emaSlow) / safeAtr

var float scoreTrendLong = 0.0
var float scoreTrendShort = 0.0
scoreTrendLong := 0.0
scoreTrendShort := 0.0

if bullishTrendAlign
    scoreTrendLong += 45.0
else if close > emaMed and emaFast > emaMed
    scoreTrendLong += 25.0

if fastSlopeUp and medSlopeUp
    scoreTrendLong += 25.0
else if fastSlopeUp
    scoreTrendLong += 10.0

if hmaSlopeUp
    scoreTrendLong += 15.0

if close > emaFast
    scoreTrendLong += 15.0

if bearishTrendAlign
    scoreTrendShort += 45.0
else if close < emaMed and emaFast < emaMed
    scoreTrendShort += 25.0

if not fastSlopeUp and not medSlopeUp
    scoreTrendShort += 25.0
else if not fastSlopeUp
    scoreTrendShort += 10.0

if not hmaSlopeUp
    scoreTrendShort += 15.0

if close < emaFast
    scoreTrendShort += 15.0

scoreTrendLong := math.min(100.0, math.max(0.0, scoreTrendLong))
scoreTrendShort := math.min(100.0, math.max(0.0, scoreTrendShort))

// --- 3. HIGHER-TIMEFRAME (HTF) TREND (STRICT ANTI-REPAINT) ---
htfShift = htfStrictAntiRepaint ? 1 : 0
[htfClose, htfFastEma, htfSlowEma] = request.security(syminfo.tickerid, htfTimeframe, [close[htfShift], ta.ema(close, htfFastEmaLen)[htfShift], ta.ema(close, htfSlowEmaLen)[htfShift]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

htfBullish = not na(htfClose) and (htfClose > htfFastEma) and (htfFastEma > htfSlowEma)
htfBearish = not na(htfClose) and (htfClose < htfFastEma) and (htfFastEma < htfSlowEma)
htfFastRising = not na(htfFastEma) and (htfFastEma > htfFastEma[1])

var float scoreHtfLong = 0.0
var float scoreHtfShort = 0.0
scoreHtfLong := 0.0
scoreHtfShort := 0.0

if htfBullish
    scoreHtfLong += 60.0
    if htfFastRising
        scoreHtfLong += 40.0
else if not na(htfClose) and htfClose > htfFastEma
    scoreHtfLong += 30.0

if htfBearish
    scoreHtfShort += 60.0
    if not htfFastRising
        scoreHtfShort += 40.0
else if not na(htfClose) and htfClose < htfFastEma
    scoreHtfShort += 30.0

scoreHtfLong := math.min(100.0, math.max(0.0, scoreHtfLong))
scoreHtfShort := math.min(100.0, math.max(0.0, scoreHtfShort))

// --- 4. MOMENTUM ENGINE ---
rsiVal = ta.rsi(close, rsiLen)
normMom = (close - nz(close[10], close)) / safeAtr

macdLine = ta.ema(close, 12) - ta.ema(close, 26)
macdSignal = ta.ema(macdLine, 9)
macdHist = macdLine - macdSignal
normMacdHist = macdHist / safeAtr

distEmaMedAtr = (close - emaMed) / safeAtr
distEmaFastAtr = (close - emaFast) / safeAtr

var float scoreMomLong = 0.0
var float scoreMomShort = 0.0
scoreMomLong := 0.0
scoreMomShort := 0.0

if rsiVal > 50.0 and rsiVal <= 68.0
    scoreMomLong += 35.0
else if rsiVal > 68.0 and rsiVal <= 75.0
    scoreMomLong += 15.0

if normMom > 0.3
    scoreMomLong += 25.0
else if normMom > 0.0
    scoreMomLong += 10.0

if normMacdHist > 0.0
    scoreMomLong += 25.0
    if normMacdHist > normMacdHist[1]
        scoreMomLong += 10.0

if distEmaMedAtr > 0.0 and distEmaMedAtr < 2.2
    scoreMomLong += 15.0

if rsiVal < 50.0 and rsiVal >= 32.0
    scoreMomShort += 35.0
else if rsiVal < 32.0 and rsiVal >= 25.0
    scoreMomShort += 15.0

if normMom < -0.3
    scoreMomShort += 25.0
else if normMom < 0.0
    scoreMomShort += 10.0

if normMacdHist < 0.0
    scoreMomShort += 25.0
    if normMacdHist < normMacdHist[1]
        scoreMomShort += 10.0

if distEmaMedAtr < 0.0 and distEmaMedAtr > -2.2
    scoreMomShort += 15.0

scoreMomLong := math.min(100.0, math.max(0.0, scoreMomLong))
scoreMomShort := math.min(100.0, math.max(0.0, scoreMomShort))

// --- 5. DIRECTIONAL & ADX ENGINE ---
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmoothing)
diSum = diPlus + diMinus
diSpreadNorm = diSum != 0.0 ? (diPlus - diMinus) / diSum : 0.0

var float scoreAdxLong = 0.0
var float scoreAdxShort = 0.0
scoreAdxLong := 0.0
scoreAdxShort := 0.0

if diPlus > diMinus
    scoreAdxLong += 40.0
    if diSpreadNorm > 0.2
        scoreAdxLong += 20.0
    if adxVal >= adxTrendLevel
        scoreAdxLong += 40.0
    else if adxVal >= 16.0
        scoreAdxLong += 20.0

if diMinus > diPlus
    scoreAdxShort += 40.0
    if diSpreadNorm < -0.2
        scoreAdxShort += 20.0
    if adxVal >= adxTrendLevel
        scoreAdxShort += 40.0
    else if adxVal >= 16.0
        scoreAdxShort += 20.0

scoreAdxLong := math.min(100.0, math.max(0.0, scoreAdxLong))
scoreAdxShort := math.min(100.0, math.max(0.0, scoreAdxShort))

// --- 6. RSI REGIME (CARDWELL RANGE DISCIPLINE) ---
var float scoreRsiRegimeLong = 0.0
var float scoreRsiRegimeShort = 0.0
scoreRsiRegimeLong := 0.0
scoreRsiRegimeShort := 0.0

if rsiVal >= 42.0 and rsiVal <= 75.0
    if rsiVal >= 48.0 and rsiVal <= 65.0
        scoreRsiRegimeLong := 100.0
    else if rsiVal > 65.0 and rsiVal <= 72.0
        scoreRsiRegimeLong := 70.0
    else
        scoreRsiRegimeLong := 75.0

if rsiVal >= 25.0 and rsiVal <= 58.0
    if rsiVal >= 35.0 and rsiVal <= 52.0
        scoreRsiRegimeShort := 100.0
    else if rsiVal >= 28.0 and rsiVal < 35.0
        scoreRsiRegimeShort := 70.0
    else
        scoreRsiRegimeShort := 75.0

// --- 7. VWAP RELATIONSHIP ---
vwapVal = ta.vwap(hlc3)
safeVwap = na(vwapVal) ? close : vwapVal
distVwapAtr = (close - safeVwap) / safeAtr
vwapSlopeUp = safeVwap >= nz(safeVwap[1], safeVwap)

var float scoreVwapLong = 0.0
var float scoreVwapShort = 0.0
scoreVwapLong := 0.0
scoreVwapShort := 0.0

if close > safeVwap
    scoreVwapLong += 50.0
    if vwapSlopeUp
        scoreVwapLong += 30.0
    if distVwapAtr > 0.05 and distVwapAtr < 2.0
        scoreVwapLong += 20.0

if close < safeVwap
    scoreVwapShort += 50.0
    if not vwapSlopeUp
        scoreVwapShort += 30.0
    if distVwapAtr < -0.05 and distVwapAtr > -2.0
        scoreVwapShort += 20.0

scoreVwapLong := math.min(100.0, math.max(0.0, scoreVwapLong))
scoreVwapShort := math.min(100.0, math.max(0.0, scoreVwapShort))

// --- 8. VOLUME CONFIRMATION & MONEY FLOW ---
volSma = ta.sma(volume, 20)
rVol = volSma > 0.0 ? (volume / volSma) : 1.0

mfMultiplier = (high - low != 0.0) ? ((close - low) - (high - close)) / (high - low) : 0.0
cmfVolume = mfMultiplier * volume
safeVolSum = ta.sma(volume, 20) * 20
cmfVal = safeVolSum > 0.0 ? (ta.sma(cmfVolume, 20) * 20) / safeVolSum : 0.0

var float scoreVolLong = 0.0
var float scoreVolShort = 0.0
scoreVolLong := 0.0
scoreVolShort := 0.0

if rVol >= 1.0
    scoreVolLong += 40.0
    if rVol >= 1.4
        scoreVolLong += 20.0
    if cmfVal > 0.05
        scoreVolLong += 40.0
    else if cmfVal > 0.0
        scoreVolLong += 20.0
else if rVol >= 0.7 and cmfVal > 0.0
    scoreVolLong += 30.0

if rVol >= 1.0
    scoreVolShort += 40.0
    if rVol >= 1.4
        scoreVolShort += 20.0
    if cmfVal < -0.05
        scoreVolShort += 40.0
    else if cmfVal < 0.0
        scoreVolShort += 20.0
else if rVol >= 0.7 and cmfVal < 0.0
    scoreVolShort += 30.0

scoreVolLong := math.min(100.0, math.max(0.0, scoreVolLong))
scoreVolShort := math.min(100.0, math.max(0.0, scoreVolShort))

// --- 9. PRICE Z-SCORE & DISTRIBUTION ---
zMean = ta.sma(close, zScoreLen)
zStd = ta.stdev(close, zScoreLen)
zScore = zStd > 0.0 ? (close - zMean) / zStd : 0.0

var float scoreZLong = 0.0
var float scoreZShort = 0.0
scoreZLong := 0.0
scoreZShort := 0.0

if adxVal >= 18.0
    if zScore >= 0.2 and zScore <= 1.8
        scoreZLong := 85.0
    else if zScore > 1.8 and zScore <= 2.5
        scoreZLong := 45.0
    else if zScore < -0.2 and zScore > -1.5 and bullishTrendAlign
        scoreZLong := 80.0

    if zScore <= -0.2 and zScore >= -1.8
        scoreZShort := 85.0
    else if zScore < -1.8 and zScore >= -2.5
        scoreZShort := 45.0
    else if zScore > 0.2 and zScore < 1.5 and bearishTrendAlign
        scoreZShort := 80.0
else
    if zScore <= -1.8
        scoreZLong := 90.0
    else if zScore <= -0.8
        scoreZLong := 60.0
    if zScore >= 1.8
        scoreZShort := 90.0
    else if zScore >= 0.8
        scoreZShort := 60.0

scoreZLong := math.min(100.0, math.max(0.0, scoreZLong))
scoreZShort := math.min(100.0, math.max(0.0, scoreZShort))

// --- 10. PRICE CURVATURE (SECOND DERIVATIVE ACCELERATION) ---
priceCurvatureRaw = (close - 2.0 * nz(close[1], close) + nz(close[2], close)) / safeAtr
priceCurvature = ta.ema(priceCurvatureRaw, curvatureSmoothLen)

var float scoreCurvLong = 0.0
var float scoreCurvShort = 0.0
scoreCurvLong := 0.0
scoreCurvShort := 0.0

if priceCurvature > 0.1
    scoreCurvLong += 50.0
    if priceCurvature > 0.25
        scoreCurvLong += 30.0
    if priceCurvature > priceCurvature[1]
        scoreCurvLong += 20.0
else if priceCurvature > 0.0
    scoreCurvLong += 30.0

if priceCurvature < -0.1
    scoreCurvShort += 50.0
    if priceCurvature < -0.25
        scoreCurvShort += 30.0
    if priceCurvature < priceCurvature[1]
        scoreCurvShort += 20.0
else if priceCurvature < 0.0
    scoreCurvShort += 30.0

scoreCurvLong := math.min(100.0, math.max(0.0, scoreCurvLong))
scoreCurvShort := math.min(100.0, math.max(0.0, scoreCurvShort))

// --- 11. MARKET STRUCTURE & BREAK OF STRUCTURE (BOS) (NON-REPAINTING) ---
ph = ta.pivothigh(high, pivotLeftBars, pivotRightBars)
pl = ta.pivotlow(low, pivotLeftBars, pivotRightBars)

var float lastPivotHigh = na
var float prevPivotHigh = na
var float lastPivotLow = na
var float prevPivotLow = na

if not na(ph)
    prevPivotHigh := lastPivotHigh
    lastPivotHigh := ph

if not na(pl)
    prevPivotLow := lastPivotLow
    lastPivotLow := pl

bullishBos = not na(lastPivotHigh) and ta.crossover(close, lastPivotHigh)
bearishBos = not na(lastPivotLow) and ta.crossunder(close, lastPivotLow)

higherHighs = not na(lastPivotHigh) and not na(prevPivotHigh) and (lastPivotHigh > prevPivotHigh)
higherLows = not na(lastPivotLow) and not na(prevPivotLow) and (lastPivotLow > prevPivotLow)
lowerHighs = not na(lastPivotHigh) and not na(prevPivotHigh) and (lastPivotHigh < prevPivotHigh)
lowerLows = not na(lastPivotLow) and not na(prevPivotLow) and (lastPivotLow < prevPivotLow)

var float scoreStructLong = 0.0
var float scoreStructShort = 0.0
scoreStructLong := 0.0
scoreStructShort := 0.0

if bullishBos
    scoreStructLong += 50.0
if higherHighs
    scoreStructLong += 25.0
if higherLows
    scoreStructLong += 25.0

if bearishBos
    scoreStructShort += 50.0
if lowerHighs
    scoreStructShort += 25.0
if lowerLows
    scoreStructShort += 25.0

scoreStructLong := math.min(100.0, math.max(0.0, scoreStructLong))
scoreStructShort := math.min(100.0, math.max(0.0, scoreStructShort))

// --- 12. KAUFMAN PRICE EFFICIENCY RATIO (ER) ---
erNetMove = math.abs(close - nz(close[erLen], close))
erGrossPath = math.sum(math.abs(close - close[1]), erLen)
efficiencyRatio = erGrossPath > 0.0 ? (erNetMove / erGrossPath) : 0.0

var float scoreErLong = 20.0
var float scoreErShort = 20.0
scoreErLong := 20.0
scoreErShort := 20.0

if efficiencyRatio >= 0.45
    if close > close[erLen]
        scoreErLong := 100.0
    else
        scoreErShort := 100.0
else if efficiencyRatio >= 0.28
    if close > close[erLen]
        scoreErLong := 60.0
    else
        scoreErShort := 60.0

// ============================================================================
// 13. SWING EXTREMUM (BOTTOM / TOP) ENGINE
// ============================================================================
candleRange = high - low > 0.0 ? high - low : safeAtr
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
lowerWickPct = (lowerWick / candleRange) * 100.0
upperWickPct = (upperWick / candleRange) * 100.0

// Cycle Bottom (Trough) Conditions:
// 1. Extreme low distribution: z-score <= -threshold or piercing lower Bollinger Band
// 2. Curvature inflection: 2nd derivative flips from downward acceleration to positive deceleration
// 3. Absorption wick: buyers absorbed selling pressure at the swing bottom
// 4. RSI oversold rebound: RSI <= 40 and turning upward
isBottomBandTouch = low <= bbLower or zScore <= -extremumZThreshold
isBottomCurvInflect = priceCurvature > priceCurvature[1] and priceCurvature[1] < 0.0
isBottomWickAbsorb = lowerWickPct >= minRejectionWickPct
isBottomRsiRebound = rsiVal <= 42.0 and rsiVal > rsiVal[1]

isSwingTrough = isBottomBandTouch and (isBottomCurvInflect or isBottomWickAbsorb or isBottomRsiRebound) and close > low[1]

// Cycle Top (Crest) Conditions:
// 1. Extreme high distribution: z-score >= threshold or piercing upper Bollinger Band
// 2. Curvature inflection: 2nd derivative flips from upward acceleration to negative deceleration
// 3. Absorption wick: sellers absorbed buying pressure at the swing crest
// 4. RSI overbought reversal: RSI >= 58 and turning downward
isTopBandTouch = high >= bbUpper or zScore >= extremumZThreshold
isTopCurvInflect = priceCurvature < priceCurvature[1] and priceCurvature[1] > 0.0
isTopWickAbsorb = upperWickPct >= minRejectionWickPct
isTopRsiReversal = rsiVal >= 58.0 and rsiVal < rsiVal[1]

isSwingCrest = isTopBandTouch and (isTopCurvInflect or isTopWickAbsorb or isTopRsiReversal) and close < high[1]

// ============================================================================
// 14. NEWS CATALYST & MACRO EVENT ENGINE
// ============================================================================
isNewsVolumeShock = rVol >= newsVolThreshold
isNewsRangeShock = (high - low) >= (safeAtr * newsAtrExpansion)
isNewsEvent = enableNewsEngine and (isNewsVolumeShock and isNewsRangeShock)

// News Fade Triggers: Buying the bottom of news panic or shorting the top of news euphoria
newsFadeBottomBuy = isNewsEvent and isSwingTrough and newsMode == "Fade News Overreaction (Bottom/Top)"
newsFadeTopSell = isNewsEvent and isSwingCrest and newsMode == "Fade News Overreaction (Bottom/Top)"

// News Momentum Triggers: Riding the breakout shock
newsMomBullish = isNewsEvent and close > open and (close - low) >= (candleRange * 0.75) and newsMode == "Ride News Breakout Momentum"
newsMomBearish = isNewsEvent and close < open and (high - close) >= (candleRange * 0.75) and newsMode == "Ride News Breakout Momentum"

// News Blackout Filter
newsBlackoutActive = isNewsEvent and newsMode == "Halt Trading (News Blackout)"

// External News Sentiment Bias (-100 to +100)
newsSentimentLongBoost = externalNewsSentiment > 20.0 ? (externalNewsSentiment / 100.0) * 15.0 : 0.0
newsSentimentShortBoost = externalNewsSentiment < -20.0 ? (math.abs(externalNewsSentiment) / 100.0) * 15.0 : 0.0

// Optional Macro Intermarket Dollar Index (DXY)
float dxyVal = na
bool dxyFalling = false
if enableMacroIntermarket
    dxyVal := request.security("TVC:DXY", "60", close[1], ignore_invalid_symbol = true)
    dxyFalling := not na(dxyVal) and dxyVal < nz(dxyVal[1], dxyVal)

// ============================================================================
// MARKET REGIME ENGINE (6 REGIMES)
// ============================================================================
var string currentRegime = "Transition"
var color regimeColor = color.gray

isStrongTrend = adxVal >= 25.0 and efficiencyRatio >= 0.35 and math.abs(trendDistAtr) >= 0.8
isWeakTrend = (adxVal >= 16.0 and efficiencyRatio >= 0.22) or (bullishTrendAlign or bearishTrendAlign)
isHighVol = atrPercentile >= 80.0 or bbwPercentile >= 85.0
isLowVol = isVolSqueeze
isRange = adxVal < 18.0 and efficiencyRatio < 0.22 and not isHighVol and not isLowVol

if isHighVol
    currentRegime := "High Volatility"
    regimeColor := color.purple
else if isLowVol
    currentRegime := "Low Volatility"
    regimeColor := color.blue
else if isStrongTrend
    currentRegime := "Strong Trend"
    regimeColor := color.green
else if isWeakTrend
    currentRegime := "Weak Trend"
    regimeColor := color.teal
else if isRange
    currentRegime := "Range"
    regimeColor := color.orange
else
    currentRegime := "Transition"
    regimeColor := color.gray

// Adaptive Stop / Target Multipliers
var float effectiveStopMult = baseAtrStopMult
var float effectiveRr = baseTargetRr
var float effectiveLongThreshold = longThreshold
var float effectiveShortThreshold = shortThreshold

effectiveStopMult := baseAtrStopMult
effectiveRr := baseTargetRr
effectiveLongThreshold := longThreshold
effectiveShortThreshold := shortThreshold

if adaptiveRrEnabled
    if currentRegime == "Strong Trend"
        effectiveRr := baseTargetRr * 1.30
        effectiveStopMult := baseAtrStopMult * 0.95
        effectiveLongThreshold -= 2.0
        effectiveShortThreshold -= 2.0
    else if currentRegime == "Range"
        effectiveRr := baseTargetRr * 0.80
        effectiveLongThreshold += 2.0
        effectiveShortThreshold += 2.0
    else if currentRegime == "High Volatility"
        effectiveStopMult := baseAtrStopMult * 1.25
        effectiveLongThreshold += 3.0
        effectiveShortThreshold += 3.0
    else if currentRegime == "Low Volatility"
        effectiveLongThreshold += 1.0
        effectiveShortThreshold += 1.0

// ============================================================================
// COMPOSITE SCORING MODEL (0 - 100)
// ============================================================================
sumWeights = w_trend + w_htf + w_mom + w_adx + w_rsiRegime + w_vwap + w_volume + w_volatility + w_zScore + w_curvature + w_structure + w_er
safeSumWeights = sumWeights <= 0.0 ? 1.0 : sumWeights

rawLongScore = (scoreTrendLong * w_trend + scoreHtfLong * w_htf + scoreMomLong * w_mom + scoreAdxLong * w_adx + scoreRsiRegimeLong * w_rsiRegime + scoreVwapLong * w_vwap + scoreVolLong * w_volume + (100.0 - atrPercentile) * (w_volatility * 0.5) + (isVolSqueeze ? 50.0 : 0.0) * (w_volatility * 0.5) + scoreZLong * w_zScore + scoreCurvLong * w_curvature + scoreStructLong * w_structure + scoreErLong * w_er) / safeSumWeights + newsSentimentLongBoost + (dxyFalling ? 5.0 : 0.0)
rawShortScore = (scoreTrendShort * w_trend + scoreHtfShort * w_htf + scoreMomShort * w_mom + scoreAdxShort * w_adx + scoreRsiRegimeShort * w_rsiRegime + scoreVwapShort * w_vwap + scoreVolShort * w_volume + (100.0 - atrPercentile) * (w_volatility * 0.5) + (isVolSqueeze ? 50.0 : 0.0) * (w_volatility * 0.5) + scoreZShort * w_zScore + scoreCurvShort * w_curvature + scoreStructShort * w_structure + scoreErShort * w_er) / safeSumWeights + newsSentimentShortBoost + (not dxyFalling and not na(dxyVal) ? 5.0 : 0.0)

compositeLongScore = math.min(100.0, math.max(0.0, rawLongScore))
compositeShortScore = math.min(100.0, math.max(0.0, rawShortScore))

// ============================================================================
// ENTRY TRIGGERS: HYBRID, EXTREMUM (BOTTOM/TOP) & TRENDS
// ============================================================================
// HTF Contradiction with BOS Override
htfLongContradiction = requireHtfNonOpposite and htfBearish and not (allowBosHtfOverride and (bullishBos or isSwingTrough))
htfShortContradiction = requireHtfNonOpposite and htfBullish and not (allowBosHtfOverride and (bearishBos or isSwingCrest))

// Anti-Exhaustion Gating for trend entries (prevents buying at peak of extended spikes)
longExhausted = enableAntiExhaustion and (distEmaFastAtr > maxDistFastAtr or distEmaMedAtr > maxDistMedAtr or rsiVal > maxLongRsi or zScore > 2.0)
shortExhausted = enableAntiExhaustion and (distEmaFastAtr < -maxDistFastAtr or distEmaMedAtr < -maxDistMedAtr or rsiVal < minShortRsi or zScore < -2.0)

// Trend Entry Triggers: Pullback to value or breakout
trendLongPullback = close >= emaFast and low <= emaFast * 1.003 and fastSlopeUp
trendLongBreakout = bullishBos or (isVolSqueeze[1] and close > bbUpper)
trendLongValid = (trendLongPullback or trendLongBreakout or (close > safeVwap and vwapSlopeUp)) and not longExhausted

trendShortPullback = close <= emaFast and high >= emaFast * 0.997 and not fastSlopeUp
trendShortBreakout = bearishBos or (isVolSqueeze[1] and close < bbLower)
trendShortValid = (trendShortPullback or trendShortBreakout or (close < safeVwap and not vwapSlopeUp)) and not shortExhausted

// Mode Dispatch:
bool longEntryTrigger = false
bool shortEntryTrigger = false

if executionStyle == "Extremum Reversals (Lowest/Highest Points)"
    longEntryTrigger := (isSwingTrough or newsFadeBottomBuy)
    shortEntryTrigger := (isSwingCrest or newsFadeTopSell)
else if executionStyle == "Trend Pullbacks & Breakouts"
    longEntryTrigger := (trendLongValid or newsMomBullish)
    shortEntryTrigger := (trendShortValid or newsMomBearish)
else // "Hybrid (Bottom/Top Extremum + Trends)"
    longEntryTrigger := isSwingTrough or newsFadeBottomBuy or trendLongValid or newsMomBullish
    shortEntryTrigger := isSwingCrest or newsFadeTopSell or trendShortValid or newsMomBearish

minAtrSatisfied = atrPct >= minAtrPctFilter
adxFilterSatisfied = (currentRegime == "Range" or currentRegime == "Low Volatility" or isSwingTrough or isSwingCrest) ? true : (adxVal >= minAdxTrendFilter)

var int lastExitBar = -100
var int tradesToday = 0
var int lastTradeDay = -1
var float lastExitPrice = na
var string lastExitDirection = ""

currentDay = dayofmonth(time)
if currentDay != lastTradeDay
    tradesToday := 0
    lastTradeDay := currentDay

cooldownPassed = (bar_index - lastExitBar >= cooldownBars) and (strategy.position_size != 0 or tradesToday < maxTradesPerDay)
antiChopLongPassed = na(lastExitPrice) or lastExitDirection != "LONG" or (close < lastExitPrice) or (bar_index - lastExitBar >= cooldownBars * 2) or bullishBos or isSwingTrough
antiChopShortPassed = na(lastExitPrice) or lastExitDirection != "SHORT" or (close > lastExitPrice) or (bar_index - lastExitBar >= cooldownBars * 2) or bearishBos or isSwingCrest

validLongSignal = cooldownPassed and not newsBlackoutActive and minAtrSatisfied and adxFilterSatisfied and not htfLongContradiction and longEntryTrigger and antiChopLongPassed and (compositeLongScore >= effectiveLongThreshold or isSwingTrough) and (compositeLongScore > compositeShortScore + 5.0)
validShortSignal = cooldownPassed and not newsBlackoutActive and minAtrSatisfied and adxFilterSatisfied and not htfShortContradiction and shortEntryTrigger and antiChopShortPassed and (compositeShortScore >= effectiveShortThreshold or isSwingCrest) and (compositeShortScore > compositeLongScore + 5.0)

// ============================================================================
// POSITION SIZING ENGINE (UNIVERSAL FUTURES, CRYPTO & EQUITIES)
// ============================================================================
f_calculate_position_size(_stopDist, _score, _threshold) =>
    float calculatedQty = 0.0
    if sizingMode == "% of Equity Capital"
        calculatedQty := close > 0.0 ? (strategy.equity * (capitalAllocationPct / 100.0)) / close : 0.0
    else if sizingMode == "Risk % of Equity"
        calculatedQty := _stopDist > 0.0 ? (strategy.equity * (riskPerTradePct / 100.0)) / _stopDist : 0.0
    else
        calculatedQty := fixedUnitsQty

    if enableConfidenceSizing and _score > _threshold
        float scoreScale = 1.0 + math.min(0.30, ((_score - _threshold) / (100.0 - _threshold)) * 0.30)
        calculatedQty := calculatedQty * scoreScale

    if syminfo.type == "futures"
        calculatedQty := math.max(1.0, math.round(calculatedQty))
    calculatedQty

// ============================================================================
// STRATEGY EXECUTION ENGINE
// ============================================================================
var float entryPriceState = na
var float currentSlPrice = na
var float currentTpPrice = na
var int entryBarState = na
var bool isBeActivated = false
var bool isTrailActive = false

isConfirmedBar = barstate.isconfirmed

// Track exits to record last trade details
if strategy.position_size == 0
    if strategy.position_size[1] != 0
        lastExitBar := bar_index
        lastExitPrice := close
        lastExitDirection := strategy.position_size[1] > 0 ? "LONG" : "SHORT"
    entryPriceState := na
    currentSlPrice := na
    currentTpPrice := na
    entryBarState := na
    isBeActivated := false
    isTrailActive := false

// --- ENTRY EXECUTION ---
if isConfirmedBar and strategy.position_size == 0 and validLongSignal
    stopDistance = safeAtr * effectiveStopMult
    entryQty = f_calculate_position_size(stopDistance, compositeLongScore, effectiveLongThreshold)
    if entryQty > 0.0
        string entryReason = isSwingTrough ? "Trough Bottom Buy" : (newsFadeBottomBuy ? "News Fade Buy" : (newsMomBullish ? "News Momentum Buy" : "AQMRS Long"))
        strategy.entry("Long", strategy.long, qty = entryQty, comment = entryReason)
        entryPriceState := close
        currentSlPrice := close - stopDistance
        currentTpPrice := close + (stopDistance * effectiveRr)
        entryBarState := bar_index
        tradesToday += 1

        if showPriceLabels
            label.new(bar_index, low - (safeAtr * 0.4), "BUY\n" + str.tostring(close, "#.##"), color = color.new(color.green, 20), textcolor = color.white, style = label.style_label_up, size = size.small)

if isConfirmedBar and strategy.position_size == 0 and validShortSignal
    stopDistance = safeAtr * effectiveStopMult
    entryQty = f_calculate_position_size(stopDistance, compositeShortScore, effectiveShortThreshold)
    if entryQty > 0.0
        string entryReason = isSwingCrest ? "Crest Top Sell" : (newsFadeTopSell ? "News Fade Sell" : (newsMomBearish ? "News Momentum Sell" : "AQMRS Short"))
        strategy.entry("Short", strategy.short, qty = entryQty, comment = entryReason)
        entryPriceState := close
        currentSlPrice := close + stopDistance
        currentTpPrice := close - (stopDistance * effectiveRr)
        entryBarState := bar_index
        tradesToday += 1

        if showPriceLabels
            label.new(bar_index, high + (safeAtr * 0.4), "SELL\n" + str.tostring(close, "#.##"), color = color.new(color.red, 20), textcolor = color.white, style = label.style_label_down, size = size.small)

// --- DYNAMIC TRADE MANAGEMENT (TRAILING STOP, BREAK-EVEN, TIME EXITS) ---
if strategy.position_size > 0
    if na(entryPriceState)
        entryPriceState := strategy.position_avg_price
        currentSlPrice := entryPriceState - (safeAtr * effectiveStopMult)
        currentTpPrice := entryPriceState + ((safeAtr * effectiveStopMult) * effectiveRr)
        entryBarState := bar_index

    // 1. Break-Even Stop
    if enableBreakEven and not isBeActivated
        if high >= entryPriceState + (safeAtr * beTriggerAtr)
            currentSlPrice := math.max(currentSlPrice, entryPriceState + (safeAtr * beOffsetAtr))
            isBeActivated := true

    // 2. Dynamic Trailing Stop (Ratchets without choking)
    if enableTrailingStop
        if high >= entryPriceState + (safeAtr * trailActivationAtr)
            isTrailActive := true
        if isTrailActive
            candidateTrail = ta.highest(high, trailLookback) - (safeAtr * trailAtrMult)
            currentSlPrice := math.max(currentSlPrice, candidateTrail)

    // 3. Trend Reversal Exit (Confirmed Fast-Med Cross)
    if exitOnMomentumCollapse and (close < emaMed and emaFast < emaMed)
        strategy.close("Long", comment = "Long Exit: Trend Reversal")

    // 4. Extreme Opposite Score Exit
    if exitOnOppositeScore and compositeShortScore >= oppExitScoreThreshold
        strategy.close("Long", comment = "Long Exit: High Short Score")

    // 5. Max Holding Period Exit
    if maxHoldingBars > 0 and not na(entryBarState) and (bar_index - entryBarState >= maxHoldingBars)
        strategy.close("Long", comment = "Long Exit: Time Limit")

    strategy.exit("Exit Long", from_entry = "Long", stop = currentSlPrice, limit = currentTpPrice, comment_loss = "Long SL Hit", comment_profit = "Long TP Hit")

else if strategy.position_size < 0
    if na(entryPriceState)
        entryPriceState := strategy.position_avg_price
        currentSlPrice := entryPriceState + (safeAtr * effectiveStopMult)
        currentTpPrice := entryPriceState - ((safeAtr * effectiveStopMult) * effectiveRr)
        entryBarState := bar_index

    if enableBreakEven and not isBeActivated
        if low <= entryPriceState - (safeAtr * beTriggerAtr)
            currentSlPrice := math.min(currentSlPrice, entryPriceState - (safeAtr * beOffsetAtr))
            isBeActivated := true

    if enableTrailingStop
        if low <= entryPriceState - (safeAtr * trailActivationAtr)
            isTrailActive := true
        if isTrailActive
            candidateTrail = ta.lowest(low, trailLookback) + (safeAtr * trailAtrMult)
            currentSlPrice := math.min(currentSlPrice, candidateTrail)

    if exitOnMomentumCollapse and (close > emaMed and emaFast > emaMed)
        strategy.close("Short", comment = "Short Exit: Trend Reversal")

    if exitOnOppositeScore and compositeLongScore >= oppExitScoreThreshold
        strategy.close("Short", comment = "Short Exit: High Long Score")

    if maxHoldingBars > 0 and not na(entryBarState) and (bar_index - entryBarState >= maxHoldingBars)
        strategy.close("Short", comment = "Short Exit: Time Limit")

    strategy.exit("Exit Short", from_entry = "Short", stop = currentSlPrice, limit = currentTpPrice, comment_loss = "Short SL Hit", comment_profit = "Short TP Hit")

// ============================================================================
// ALERTS (WEBHOOK / AUTOMATION COMPLIANT JSON)
// ============================================================================
if isConfirmedBar and validLongSignal and strategy.position_size == 0
    alertMsgLong = '{"strategy":"AQMRS","event":"ENTRY_LONG","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":' + str.tostring(close, "#.##") + ',"sl":' + str.tostring(close - (safeAtr * effectiveStopMult), "#.##") + ',"tp":' + str.tostring(close + (safeAtr * effectiveStopMult * effectiveRr), "#.##") + ',"score":' + str.tostring(compositeLongScore, "#.#") + ',"regime":"' + currentRegime + '"}'
    alert(alertMsgLong, alert.freq_once_per_bar_close)

if isConfirmedBar and validShortSignal and strategy.position_size == 0
    alertMsgShort = '{"strategy":"AQMRS","event":"ENTRY_SHORT","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":' + str.tostring(close, "#.##") + ',"sl":' + str.tostring(close + (safeAtr * effectiveStopMult), "#.##") + ',"tp":' + str.tostring(close - (safeAtr * effectiveStopMult * effectiveRr), "#.##") + ',"score":' + str.tostring(compositeShortScore, "#.#") + ',"regime":"' + currentRegime + '"}'
    alert(alertMsgShort, alert.freq_once_per_bar_close)

// ============================================================================
// CHART VISUALIZATIONS & AESTHETICS
// ============================================================================
p_fast = plot(showEmaLines ? emaFast : na, "Fast EMA (9)", color = color.new(color.teal, 20), linewidth = 1)
p_med = plot(showEmaLines ? emaMed : na, "Medium EMA (50)", color = color.new(color.orange, 15), linewidth = 2)
plot(showEmaLines ? emaSlow : na, "Slow EMA (200)", color = color.new(color.blue, 30), linewidth = 2)

// Trend Cloud between Fast and Med EMA
fill(p_fast, p_med, color = showEmaCloud ? (emaFast >= emaMed ? color.new(color.teal, 88) : color.new(color.maroon, 88)) : na, title = "Trend Cloud")

plot(showVwapLine ? safeVwap : na, "VWAP", color = color.new(color.yellow, 25), linewidth = 2)

// Active Stop, Target, and Entry Lines
plot(showStopTargetLines and strategy.position_size != 0 ? currentSlPrice : na, "Active Stop Loss", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(showStopTargetLines and strategy.position_size != 0 ? currentTpPrice : na, "Active Take Profit", color = color.green, style = plot.style_linebr, linewidth = 2)
plot(showStopTargetLines and strategy.position_size != 0 ? entryPriceState : na, "Entry Fill Price", color = color.gray, style = plot.style_linebr, linewidth = 1)

// Clean Entry Markers
plotshape(showSignals and isConfirmedBar and validLongSignal and strategy.position_size == 0, "Long Signal Marker", shape.triangleup, location.belowbar, color.new(color.green, 0), size = size.small)
plotshape(showSignals and isConfirmedBar and validShortSignal and strategy.position_size == 0, "Short Signal Marker", shape.triangledown, location.abovebar, color.new(color.red, 0), size = size.small)

// Dedicated Exit Markers & Exit Badges
var int prevClosedTradesCount = 0
bool tradeJustClosed = strategy.closedtrades > prevClosedTradesCount
prevClosedTradesCount := strategy.closedtrades

float lastTradeProfit = (tradeJustClosed and strategy.closedtrades > 0) ? strategy.closedtrades.profit(math.max(0, strategy.closedtrades - 1)) : 0.0
bool isWinTrade = tradeJustClosed and lastTradeProfit > 0.0
bool isLossTrade = tradeJustClosed and lastTradeProfit <= 0.0

plotshape(showExitMarkers and isWinTrade, "Take Profit Exit", shape.circle, location.abovebar, color.new(color.green, 10), size = size.tiny, text = "TP", textcolor = color.white)
plotshape(showExitMarkers and isLossTrade, "Stop Loss Exit", shape.xcross, location.belowbar, color.new(color.red, 10), size = size.tiny, text = "SL", textcolor = color.white)

if showExitMarkers and tradeJustClosed
    string exitText = isWinTrade ? "TP +" + str.tostring(lastTradeProfit, "#.##") : "SL " + str.tostring(lastTradeProfit, "#.##")
    color exitCol = isWinTrade ? color.green : color.red
    label.new(bar_index, isWinTrade ? high + (safeAtr * 0.3) : low - (safeAtr * 0.3), exitText, color = color.new(exitCol, 20), textcolor = color.white, style = isWinTrade ? label.style_label_down : label.style_label_up, size = size.small)

// ============================================================================
// QUANTITATIVE DASHBOARD TABLE
// ============================================================================
var table dashTable = table.new(position.bottom_right, 2, 13, bgcolor = color.new(color.black, 15), border_color = color.new(color.gray, 60), border_width = 1)

if showDashboard and barstate.islast
    table_pos = dashboardPos == "Top Right" ? position.top_right : dashboardPos == "Top Left" ? position.top_left : dashboardPos == "Bottom Left" ? position.bottom_left : position.bottom_right
    table.set_position(dashTable, table_pos)
    t_size = dashboardTextSize == "Tiny" ? size.tiny : size.small

    table.cell(dashTable, 0, 0, "AQMRS QUANT DESK", bgcolor = color.new(color.blue, 30), text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 0, "v6 Production", bgcolor = color.new(color.blue, 30), text_color = color.white, text_size = t_size)

    table.cell(dashTable, 0, 1, "Market Regime", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 1, currentRegime, bgcolor = regimeColor, text_color = color.white, text_size = t_size)

    table.cell(dashTable, 0, 2, "Long Score", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 2, str.tostring(compositeLongScore, "#.#") + " / 100", bgcolor = compositeLongScore >= effectiveLongThreshold ? color.new(color.green, 30) : color.new(color.gray, 70), text_color = color.white, text_size = t_size)

    table.cell(dashTable, 0, 3, "Short Score", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 3, str.tostring(compositeShortScore, "#.#") + " / 100", bgcolor = compositeShortScore >= effectiveShortThreshold ? color.new(color.red, 30) : color.new(color.gray, 70), text_color = color.white, text_size = t_size)

    string swingState = isSwingTrough ? "BOTTOM TROUGH" : (isSwingCrest ? "TOP CREST" : "IN SWING")
    color swingColor = isSwingTrough ? color.green : (isSwingCrest ? color.red : color.gray)
    table.cell(dashTable, 0, 4, "Swing Extremum", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 4, swingState, bgcolor = color.new(swingColor, 40), text_color = color.white, text_size = t_size)

    string newsState = isNewsEvent ? (newsMode == "Fade News Overreaction (Bottom/Top)" ? "NEWS FADE READY" : "NEWS SHOCK ACTIVE") : (externalNewsSentiment != 0.0 ? "SENTIMENT: " + str.tostring(externalNewsSentiment, "#") : "NORMAL")
    table.cell(dashTable, 0, 5, "News / Macro Event", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 5, newsState, bgcolor = isNewsEvent ? color.new(color.purple, 30) : color.new(color.gray, 70), text_color = color.white, text_size = t_size)

    table.cell(dashTable, 0, 6, "Trend Bias", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 6, bullishTrendAlign ? "BULLISH" : (bearishTrendAlign ? "BEARISH" : "MIXED"), text_color = bullishTrendAlign ? color.green : (bearishTrendAlign ? color.red : color.yellow), text_size = t_size)

    table.cell(dashTable, 0, 7, "HTF Trend (" + htfTimeframe + ")", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 7, htfBullish ? "BULLISH" : (htfBearish ? "BEARISH" : "NEUTRAL"), text_color = htfBullish ? color.green : (htfBearish ? color.red : color.gray), text_size = t_size)

    table.cell(dashTable, 0, 8, "ADX & ER", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 8, str.tostring(adxVal, "#.#") + " | " + str.tostring(efficiencyRatio, "#.##"), text_color = adxVal >= adxTrendLevel ? color.green : color.white, text_size = t_size)

    table.cell(dashTable, 0, 9, "ATR % (Rank)", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 9, str.tostring(atrPct, "#.##") + "% (" + str.tostring(atrPercentile, "#") + "%)", text_color = color.white, text_size = t_size)

    string posStr = strategy.position_size > 0 ? "LONG (" + str.tostring(strategy.position_size) + ")" : strategy.position_size < 0 ? "SHORT (" + str.tostring(strategy.position_size) + ")" : "FLAT"
    table.cell(dashTable, 0, 10, "Active Position", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 10, posStr, bgcolor = strategy.position_size > 0 ? color.new(color.green, 40) : (strategy.position_size < 0 ? color.new(color.red, 40) : color.new(color.gray, 70)), text_color = color.white, text_size = t_size)

    table.cell(dashTable, 0, 11, "Active SL / TP", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 11, strategy.position_size != 0 ? str.tostring(currentSlPrice, "#.##") + " / " + str.tostring(currentTpPrice, "#.##") : "None", text_color = color.white, text_size = t_size)

    int closedCount = strategy.closedtrades
    int winCount = strategy.wintrades
    float wrPct = closedCount > 0 ? (winCount / float(closedCount)) * 100.0 : 0.0
    table.cell(dashTable, 0, 12, "Win Rate (" + str.tostring(closedCount) + " trades)", text_color = color.white, text_size = t_size)
    table.cell(dashTable, 1, 12, str.tostring(wrPct, "#.#") + "% (" + str.tostring(winCount) + "W / " + str.tostring(closedCount - winCount) + "L)", text_color = wrPct >= 50.0 ? color.green : color.yellow, text_size = t_size)
