//@version=6
indicator(
     title               = "Adaptive Quantitative Market Regime Indicator (PineTS Compatible)",
     shorttitle          = "AQMRI",
     overlay             = false,
     precision           = 2
 )

// ============================================================================
// COMPANION INDICATOR FOR PINTS & PINETS-CLI QUANTITATIVE RESEARCH
// ============================================================================
// This indicator mirrors the exact mathematical factors of the AQMRS strategy,
// plotting the continuous multi-factor quantitative scores, Z-scores, Price Curvature,
// Cycle Trough / Crest Turning Points, and News Catalyst Shocks for integration
// with external CLI, Python, or TypeScript research pipelines.

// --- Inputs ---
grp_weights = "Multi-Factor Weights"
w_trend     = input.float(16.0, "Weight: Trend Engine", minval = 0.0, maxval = 50.0, group = grp_weights)
w_htf       = input.float(14.0, "Weight: HTF Trend", minval = 0.0, maxval = 50.0, group = grp_weights)
w_mom       = input.float(14.0, "Weight: Momentum Engine", minval = 0.0, maxval = 50.0, group = grp_weights)
w_adx       = input.float(10.0, "Weight: ADX / Directional", minval = 0.0, maxval = 50.0, group = grp_weights)
w_rsiRegime = input.float(6.0,  "Weight: RSI Regime Context", minval = 0.0, maxval = 50.0, group = grp_weights)
w_vwap      = input.float(6.0,  "Weight: VWAP Relationship", minval = 0.0, maxval = 50.0, group = grp_weights)
w_volume    = input.float(6.0,  "Weight: Volume Confirmation", minval = 0.0, maxval = 50.0, group = grp_weights)
w_volatility= input.float(6.0,  "Weight: Volatility Regime", minval = 0.0, maxval = 50.0, group = grp_weights)
w_zScore    = input.float(6.0,  "Weight: Price Z-Score", minval = 0.0, maxval = 50.0, group = grp_weights)
w_curvature = input.float(6.0,  "Weight: Price Curvature (2nd Deriv)", minval = 0.0, maxval = 50.0, group = grp_weights)
w_structure = input.float(10.0, "Weight: Market Structure (BOS)", minval = 0.0, maxval = 50.0, group = grp_weights)
w_er        = input.float(6.0,  "Weight: Kaufman Price Efficiency", minval = 0.0, maxval = 50.0, group = grp_weights)

grp_extremum = "Cycle Extremum & News Catalyst Engine"
showExtremumShapes = input.bool(true,  "Show Turning-Point Badges", group = grp_extremum)
showNewsShocks     = input.bool(true,  "Show News Shock Markers", group = grp_extremum)
extremumZThresh    = input.float(1.5,  "Extremum Z-Score Level", minval = 0.5, step = 0.1, group = grp_extremum)
minWickPct         = input.float(25.0, "Min Rejection Wick %", minval = 5.0, maxval = 60.0, group = grp_extremum)
rvolShockThresh    = input.float(2.2,  "News RVOL Shock Threshold", minval = 1.2, step = 0.1, group = grp_extremum)
atrShockMult       = input.float(1.8,  "News ATR Shock Multiplier", minval = 1.0, step = 0.1, group = grp_extremum)

// --- Engine Core ---
atrVal = ta.atr(14)
safeAtr = (na(atrVal) or atrVal <= 0.0) ? (close * 0.01) : atrVal
atrPercentile = nz(ta.percentrank(safeAtr, 100), 50.0)

// Trend
emaFast = ta.ema(close, 9)
emaMed  = ta.ema(close, 50)
emaSlow = ta.ema(close, 200)
bullishTrendAlign = close > emaFast and emaFast > emaMed and emaMed > emaSlow
bearishTrendAlign = close < emaFast and emaFast < emaMed and emaMed < emaSlow

// Momentum & ADX
rsiVal = ta.rsi(close, 14)
normMom = (close - nz(close[10], close)) / safeAtr
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)

// Z-Score & Bollinger Bands
zMean = ta.sma(close, 20)
zStd = ta.stdev(close, 20)
zScore = zStd > 0.0 ? (close - zMean) / zStd : 0.0
bbUpper = zMean + 2.0 * zStd
bbLower = zMean - 2.0 * zStd

// Price Curvature (2nd Derivative Acceleration)
priceCurvatureRaw = (close - 2.0 * nz(close[1], close) + nz(close[2], close)) / safeAtr
priceCurvature = ta.ema(priceCurvatureRaw, 3)

// Efficiency Ratio
erNetMove = math.abs(close - nz(close[10], close))
erGrossPath = math.sum(math.abs(close - close[1]), 10)
efficiencyRatio = erGrossPath > 0.0 ? (erNetMove / erGrossPath) : 0.0

// Wick Geometry & Volume Dynamics
candleRange = math.max(high - low, 1e-6)
lowerWickPct = ((math.min(open, close) - low) / candleRange) * 100.0
upperWickPct = ((high - math.max(open, close)) / candleRange) * 100.0

volSma = ta.sma(volume, 20)
rvol = volSma > 0.0 ? (volume / volSma) : 1.0

// Cycle Bottom / Trough & Cycle Crest / Peak Turning Points
isBottomTrough = (zScore <= -extremumZThresh or low <= bbLower) and (priceCurvature > 0.02 or priceCurvature > nz(priceCurvature[1], 0.0)) and (lowerWickPct >= minWickPct) and (rsiVal >= 25.0 and rsiVal >= nz(rsiVal[1], rsiVal))
isTopCrest    = (zScore >= extremumZThresh or high >= bbUpper) and (priceCurvature < -0.02 or priceCurvature < nz(priceCurvature[1], 0.0)) and (upperWickPct >= minWickPct) and (rsiVal <= 75.0 and rsiVal <= nz(rsiVal[1], rsiVal))

// News Catalyst & Macro Event Shock
isNewsShock   = rvol >= rvolShockThresh and candleRange >= (atrShockMult * safeAtr)

// Multi-Factor Quantitative Composite Scores
var float scoreTrendLong = 0.0
var float scoreTrendShort = 0.0
scoreTrendLong := bullishTrendAlign ? 80.0 : (close > emaMed ? 50.0 : 20.0)
scoreTrendShort := bearishTrendAlign ? 80.0 : (close < emaMed ? 50.0 : 20.0)

var float scoreMomLong = 0.0
var float scoreMomShort = 0.0
scoreMomLong := (rsiVal > 50.0 ? 50.0 : 20.0) + (normMom > 0.0 ? 40.0 : 0.0)
scoreMomShort := (rsiVal < 50.0 ? 50.0 : 20.0) + (normMom < 0.0 ? 40.0 : 0.0)

var float scoreCurvLong = 0.0
var float scoreCurvShort = 0.0
scoreCurvLong := priceCurvature > 0.1 ? 80.0 : (priceCurvature > 0.0 ? 50.0 : 20.0)
scoreCurvShort := priceCurvature < -0.1 ? 80.0 : (priceCurvature < 0.0 ? 50.0 : 20.0)

sumWeights = w_trend + w_mom + w_adx + w_zScore + w_curvature + w_er
safeWeights = sumWeights <= 0 ? 1.0 : sumWeights

rawLong = (scoreTrendLong * w_trend + scoreMomLong * w_mom + (diPlus > diMinus ? 80.0 : 20.0) * w_adx + (zScore > 0.5 ? 70.0 : 30.0) * w_zScore + scoreCurvLong * w_curvature + (efficiencyRatio * 100.0) * w_er) / safeWeights
rawShort = (scoreTrendShort * w_trend + scoreMomShort * w_mom + (diMinus > diPlus ? 80.0 : 20.0) * w_adx + (zScore < -0.5 ? 70.0 : 30.0) * w_zScore + scoreCurvShort * w_curvature + (efficiencyRatio * 100.0) * w_er) / safeWeights

longScore = math.min(100.0, math.max(0.0, rawLong))
shortScore = math.min(100.0, math.max(0.0, rawShort))

// Plots
plot(longScore, "LongScore", color = color.green, linewidth = 2)
plot(shortScore, "ShortScore", color = color.red, linewidth = 2)
plot(adxVal, "ADX", color = color.blue, linewidth = 1)
plot(efficiencyRatio * 100.0, "EfficiencyRatio", color = color.purple, linewidth = 1)
hline(68, "Signal Threshold", color = color.yellow, linestyle = hline.style_dashed)
hline(50, "Neutral Line", color = color.gray, linestyle = hline.style_dotted)

// Turning-Point & News Markers
plotshape(showExtremumShapes and isBottomTrough ? 12.0 : na, title = "Cycle Trough", style = shape.triangleup, location = location.absolute, color = color.lime, size = size.tiny, text = "TROUGH")
plotshape(showExtremumShapes and isTopCrest ? 88.0 : na, title = "Cycle Crest", style = shape.triangledown, location = location.absolute, color = color.fuchsia, size = size.tiny, text = "CREST")
plotshape(showNewsShocks and isNewsShock ? 50.0 : na, title = "News Catalyst Shock", style = shape.diamond, location = location.absolute, color = color.yellow, size = size.tiny, text = "NEWS")
